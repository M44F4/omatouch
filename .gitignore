# Python bytecode from the bin/ scripts
__pycache__/
*.pyc

# Runtime state. OmaTouch writes everything it persists to
# ~/.local/state/omarchy/omatouch/ -- these names only appear here if an
# older layout left them behind, and they must never be committed
# (radius-*.json records the active theme).
/settings.json
/radius-*.json

# Languages generated on this machine. Only en-us.json and compose.json are
# bundled; everything else belongs in the state dir and is per-user.
/languages/*.json
!/languages/en-us.json
!/languages/compose.json
!/languages/manifest.json

# Never committed -- screenshots are hosted as GitHub release assets, not
# repo content, so a plain `git clone` (what `omarchy plugin add` does,
# no --depth/--single-branch) never downloads them on install.
/screenshots/
